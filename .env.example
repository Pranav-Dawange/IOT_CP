# ==============================================================================
# Environment Configuration for Smart Industrial Asset Monitoring & Failure Prediction
# ==============================================================================
# WARNING: DO NOT COMMIT REAL PRODUCTION SECRETS OR SENSITIVE PASSWORDS.
# Copy this file to '.env' and adjust variables for your local or Docker environment.
# ==============================================================================

# Database Connection (TimescaleDB / PostgreSQL or Local SQLite)
# For local zero-config evaluation (no PostgreSQL needed):
# DATABASE_URL=sqlite:///./data/industrial_iot.db
#
# For Docker Compose:
# DATABASE_URL=postgresql://postgres:password@timescaledb:5432/industrial_iot
#
# Default native run (automatically falls back to SQLite if PostgreSQL is unreachable):
DATABASE_URL=sqlite:///./data/industrial_iot.db
POSTGRES_DB=industrial_iot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# Database Connection Pool & Resilience Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_RETRY_ATTEMPTS=2
DB_RETRY_DELAY_SECONDS=1.0

# MQTT Broker Settings
# For local native run: localhost
# For Docker Compose:  mosquitto
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=ai4i_fastapi_backend
MQTT_KEEPALIVE=60
ENABLE_MQTT_INGESTION=true
MAX_QUEUE_SIZE=1000

# Frozen Machine Learning Model & Preprocessing Contract
GRU_CHECKPOINT_PATH=ml/checkpoints/gru_model.pt
SCALER_PATH=data/processed/scaler.pkl
GRU_THRESHOLD=0.55
GRU_WINDOW_SIZE=30
GRU_PREDICTION_HORIZON=10

# Backend Service Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
