# ==============================================================================
# Environment Configuration Example for Phase 6 FastAPI Backend & TimescaleDB
# ==============================================================================
# WARNING: DO NOT COMMIT REAL PRODUCTION SECRETS OR SENSITIVE PASSWORDS.
# Copy this file to '.env' and adjust variables for your local or Docker environment.
# ==============================================================================

# Database Connection (TimescaleDB / PostgreSQL)
# For local native run: postgresql://postgres:password@localhost:5432/industrial_iot
# For Docker Compose:  postgresql://postgres:password@timescaledb:5432/industrial_iot
DATABASE_URL=postgresql://postgres:password@localhost:5432/industrial_iot
POSTGRES_DB=industrial_iot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# MQTT Broker Settings
# For local native run: localhost
# For Docker Compose:  mosquitto
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=ai4i_fastapi_backend
MQTT_KEEPALIVE=60

# Frozen Machine Learning Model & Preprocessing Contract
GRU_CHECKPOINT_PATH=ml/checkpoints/gru_model.pt
SCALER_PATH=data/processed/scaler.pkl
GRU_THRESHOLD=0.55
GRU_WINDOW_SIZE=30
GRU_PREDICTION_HORIZON=10

# Backend Service Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
